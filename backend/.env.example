# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

NODE_ENV=development
PORT=3000

# PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# En Windows usa 127.0.0.1 y no localhost: localhost intenta IPv6 primero y cada conexión tarda segundos.
DATABASE_URL=postgres://logik_app:CAMBIA_ESTA_CONTRASENA@127.0.0.1:5432/logik
DATABASE_SSL=false

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Cuenta del panel (solo se usa si todavía no existe ninguna)
ADMIN_EMAIL=logikmarketing1@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Logik Marketing

# Cuenta de soporte (opcional): segundo acceso al panel para quien da mantenimiento.
# Se crea al arrancar si no existe. Define las dos o déjalas vacías.
SUPPORT_ADMIN_EMAIL=
SUPPORT_ADMIN_PASSWORD=
SUPPORT_ADMIN_NAME=Soporte

# Orígenes permitidos para el frontend, separados por coma (en producción, solo el dominio real)
CORS_ORIGINS=http://localhost:4200

# Solo para las pruebas de integración: una base desechable (se vacía al correrlas)
TEST_DATABASE_URL=
